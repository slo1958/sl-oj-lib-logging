Private Class clLoginMessageEntry

    Public Property MessageId As String
    Public Property MessageSeverity As String
    Public Property MessageText As String
    Public Sub MyMethod(MessageTextId As string, MessageSeverity As string, MessageText As string)
    Self.MessageId = MessageTextId
    Self.MessageSeverity = MessageSeverity
    Self.MessageText = MessageText

    Return


    End Sub
End Class