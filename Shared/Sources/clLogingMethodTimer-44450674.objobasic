Private Class clLogingMethodTimer

    Public Sub EnterMethod()
    timers.Append(New clLogTaskTimer(Self.MethodName))

    End Sub
    Public Property MethodName As String
    Public Property Timers() As clLogTaskTimer
    Public Constructor(prmName As string)
    Self.MethodName = prmName

    End Constructor
    Public Sub ExitMethod()

    If timers.Count = 0 Then Return

    timers[timers.LastIndex].Done()

    Return
    End Sub
    Public Function MethodStats() As clLogMethodStats

    Var count As Integer
    Var totexecution As Double

    For Each entry As clLogTaskTimer In Self.Timers
      If entry.Completed() Then
        Pragma note "Nothing to do"

      Else
        count = count + 1
        totexecution = totexecution + entry.GetExecutionTime()

      End If

    Next

    Return New clLogMethodStats(MethodName, count, totexecution)

    End Function
End Class