Private Class clMethodTimer

    Public Sub EnterMethod()
    timers.Append(New clTaskTimer(Self.MethodName))

    End Sub
    Public Property MethodName As String
    Public Property Timers() As clTaskTimer
    Public Constructor(prmName As string)
    Self.MethodName = prmName

    End Constructor
    Public Sub ExitMethod()

    If timers.Count = 0 Then Return

    timers[timers.LastIndex].Done()

    Return
    End Sub
    Public Function MethodStatistics() As clLogMethodStatistics

    Var count As Integer
    Var totexecution As Double

    For Each entry As clTaskTimer In Self.Timers
      If entry.Completed() Then
        Pragma note "Nothing to do"

      Else
        count = count + 1
        totexecution = totexecution + entry.GetExecutionTime()

      End If

    Next

    Return New clLogMethodStatistics(MethodName, count, totexecution)

    End Function
End Class